# Copy to .env and fill in real values. Never commit .env.

# --- Environment: development | staging | production ---
ENVIRONMENT=development

# --- Database ---
# Percent-encode reserved characters in the password (e.g. '@' -> '%40').
DATABASE_URL=postgresql://postgres:password@localhost:5432/kinyamed_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters; start-up fails in production otherwise.
SECRET_KEY=replace-me-with-a-generated-secret

# --- Token signing (FR-05-05) -----------------------------------------------
# Tokens are RS256 as of 2026-09-17. SECRET_KEY no longer signs anything; it is
# still validated at start-up but no application code reads it.
#
# Generate a pair:   python -m app.core.jwt_keys
#
# Paste the PRIVATE key below. Newlines may be written as the two characters \n
# if your deployment cannot carry a multi-line value.
# Leave it UNSET in development and an ephemeral pair is generated at start-up,
# logged loudly; sessions then end when the process restarts. Production refuses
# to boot without it.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# TO ROTATE, in two deploys:
#   1. Generate a new pair. Put the OLD public PEM in JWT_RETIRED_PUBLIC_KEYS and
#      the NEW private PEM in JWT_PRIVATE_KEY. Deploy. New tokens use the new
#      key; tokens already issued still verify, so nobody is signed out.
#   2. After REFRESH_TOKEN_EXPIRE_DAYS (7) no live token can still use the old
#      key. Clear JWT_RETIRED_PUBLIC_KEYS. Deploy.
# Retired keys verify and never sign. Concatenate several if you must.
# JWT_RETIRED_PUBLIC_KEYS="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Comma-separated exact origins. '*' is rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Reverse proxies (IPs or CIDRs) whose X-Forwarded-For header is believed.
# Leave empty unless a proxy sits in front of the API: any client can write the
# header, and believing it lets a caller evade rate limits.
TRUSTED_PROXIES=

# --- Authentication ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt cost. Production is held to at least 12.
BCRYPT_ROUNDS=12
REFRESH_COOKIE_NAME=kinyamed_refresh
# Secure cookies are not sent over http, so local development sets this false.
# Production start-up fails unless it is true.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- SMS (Africa's Talking) ---
SMS_API_KEY=your_africas_talking_key
SMS_USERNAME=sandbox
SMS_SENDER_ID=KinyaMed
# Leave false until a real provider client is wired into get_sms_provider().
SMS_ENABLED=false

# --- Application ---
APP_NAME=KinyaMed
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PATIENTS=kinyamed_patients
KAFKA_TOPIC_ALERTS=kinyamed_alerts

# --- ML model ---
MODEL_NAME=Davlan/afro-xlmr-mini
# MODEL_MAX_LENGTH is read from the model directory (kinyamed_training.json).
# Set it only to the model's training length; any other value stops start-up.
# MODEL_MAX_LENGTH=
MODEL_CONFIDENCE_THRESHOLD=0.75

# --- Triage / queue tuning ---
MINUTES_PER_PATIENT=10
URGENT_MAX_WAIT_MINUTES=30
MAX_SYMPTOM_LENGTH=2000
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
